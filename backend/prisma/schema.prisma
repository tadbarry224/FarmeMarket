generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Rôles d'un compte. Un utilisateur peut en cumuler plusieurs (ex. PRODUCER + BUYER).
// ADMIN n'est jamais attribuable à l'inscription.
enum Role {
  PRODUCER
  BUYER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  fullName         String
  // Toujours stocké au format international : +224XXXXXXXXX
  phone            String            @unique
  // Facultatif, stocké en minuscules
  email            String?           @unique
  // Null tant que l'adresse n'a pas été confirmée via le lien envoyé par e-mail
  emailVerifiedAt  DateTime?
  // Empreinte argon2 : le mot de passe en clair n'est jamais stocké
  passwordHash     String
  roles            Role[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  authTokens       AuthToken[]
  // Renseigné quand un utilisateur ayant le rôle PRODUCER complète son profil producteur
  producer         Producer?
  // Demandes d'achat publiées en tant qu'acheteur
  purchaseRequests PurchaseRequest[]
  // Commandes passées en tant qu'acheteur
  orders           Order[]
  // Changements de statut de commande effectués par cet utilisateur
  orderEvents      OrderEvent[]
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Jeton à usage unique envoyé par e-mail (confirmation d'adresse, réinitialisation du mot de passe).
// Seule l'empreinte SHA-256 du jeton est stockée.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  // Renseigné dès que le jeton a servi : il devient alors inutilisable
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// Type d'exploitation déclaré par le producteur
enum FarmType {
  CROPS // cultures
  LIVESTOCK // élevage
  MIXED // cultures et élevage
  OTHER
}

// Profil public d'un producteur. Le nom et le téléphone sont ceux du compte (User).
// La région et la préfecture sont validées contre la liste officielle (src/locations/guinea-locations.ts).
model Producer {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmType     FarmType
  description  String?
  region       String
  prefecture   String
  commune      String?
  // Adresse précise : visible uniquement par le producteur lui-même
  address      String?
  // Texte libre, ex. « Riz, maïs, arachide »
  mainProducts String?
  products     Product[]
  offers       Offer[]
  // Commandes reçues (ventes)
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([region, prefecture])
}

// Catégorie de produits (Céréales, Légumes…). Les catégories initiales sont créées
// par la migration add_categories ; leur gestion par l'administrateur viendra plus tard.
model Category {
  id               String            @id @default(uuid())
  name             String            @unique
  // Exemples affichés pour aider le producteur à choisir, ex. « Riz, maïs, fonio »
  description      String?
  createdAt        DateTime          @default(now())
  products         Product[]
  purchaseRequests PurchaseRequest[]
}

// Unité de vente d'un produit (le prix est exprimé par unité)
enum ProductUnit {
  KG
  TONNE
  BAG // sac
  CRATE // caisse, cageot
  BUNCH // botte, régime
  PIECE
  HEAD // tête de bétail
  LITER
}

enum ProductStatus {
  AVAILABLE // visible dans le catalogue
  SOLD_OUT // épuisé : reste consultable mais ne peut plus être commandé
  ARCHIVED // retiré par le producteur : n'apparaît plus dans le catalogue
}

// Annonce publiée par un producteur.
// Un produit n'est jamais supprimé, il est archivé : les futures commandes devront pouvoir y faire référence.
model Product {
  id             String        @id @default(uuid())
  producerId     String
  producer       Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  // Nombre entier d'unités : pour vendre 1,5 tonne, choisir l'unité KG (1 500 kg)
  quantity       Int
  unit           ProductUnit
  // Prix en francs guinéens (GNF) par unité. Le GNF n'a pas de décimales.
  pricePerUnit   Int
  // Localisation du produit, validée comme celle du producteur
  region         String
  prefecture     String
  commune        String?
  // Période de disponibilité (dates sans heure), facultative
  availableFrom  DateTime?     @db.Date
  availableUntil DateTime?     @db.Date
  // Texte libre, ex. « Premier choix », « Bio »
  quality        String?
  // Texte libre, ex. « Sacs de 50 kg »
  packaging      String?
  status         ProductStatus @default(AVAILABLE)
  // Offres dans lesquelles le producteur a proposé ce produit
  offers         Offer[]
  // Lignes de commande portant sur ce produit
  orderItems     OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([producerId])
  @@index([categoryId])
  @@index([status])
  @@index([region, prefecture])
}

enum PurchaseRequestStatus {
  OPEN // visible par les producteurs, accepte des offres
  FULFILLED // une offre a été acceptée (phase 5 : commandes)
  CLOSED // fermée par l'acheteur
}

// Demande d'achat publiée par un acheteur (cahier des charges §8),
// ex. « 2 tonnes de tomates, 15 000 GNF/kg maximum, livraison à Conakry le 20 novembre ».
// Nommée PurchaseRequest plutôt que Request pour ne pas la confondre avec la requête HTTP d'Express.
model PurchaseRequest {
  id              String                @id @default(uuid())
  buyerId         String
  buyer           User                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Produit recherché, en texte libre (ex. « Tomates »)
  productName     String
  quantity        Int
  unit            ProductUnit
  // Budget maximum en GNF par unité, facultatif
  maxPricePerUnit Int?
  // Lieu de livraison, validé comme la localisation d'un produit
  region          String
  prefecture      String
  commune         String?
  // Date de livraison souhaitée : une fois passée, la demande n'est plus proposée aux producteurs
  desiredDate     DateTime?             @db.Date
  quality         String?
  details         String?
  status          PurchaseRequestStatus @default(OPEN)
  offers          Offer[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([categoryId])
}

enum OfferStatus {
  PENDING // en attente de la décision de l'acheteur
  ACCEPTED // acceptée par l'acheteur (phase 5 : crée une commande)
  REJECTED // refusée par l'acheteur
  WITHDRAWN // retirée par le producteur
}

// Réponse d'un producteur à une demande d'achat. Une seule offre par producteur et par demande.
model Offer {
  id            String          @id @default(uuid())
  requestId     String
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  producerId    String
  producer      Producer        @relation(fields: [producerId], references: [id], onDelete: Cascade)
  // Produit du catalogue proposé, facultatif
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Exprimée dans l'unité de la demande, pour pouvoir comparer les offres
  quantity      Int
  // Prix en GNF par unité de la demande
  pricePerUnit  Int
  // Date à partir de laquelle le producteur peut livrer, facultative
  availableFrom DateTime?       @db.Date
  message       String?
  status        OfferStatus     @default(PENDING)
  // Commande créée quand l'acheteur accepte l'offre
  order         Order?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requestId, producerId])
  @@index([producerId])
}

// Cycle de vie d'une commande (cahier des charges §10) :
// PENDING → ACCEPTED → PREPARING → SHIPPED → DELIVERED → COMPLETED,
// avec REJECTED (refusée par le producteur) et CANCELLED (annulée).
// Qui peut faire quel changement : src/orders/order-transitions.ts
enum OrderStatus {
  PENDING // en attente de l'accord du producteur (commande depuis le catalogue)
  ACCEPTED // acceptée par le producteur, ou issue d'une offre acceptée par l'acheteur
  PREPARING // en préparation
  SHIPPED // expédiée
  DELIVERED // livrée, selon le producteur
  COMPLETED // réception confirmée par l'acheteur
  REJECTED // refusée par le producteur
  CANCELLED // annulée par l'acheteur ou le producteur
}

// Commande d'un acheteur auprès d'un producteur.
// Pas de suppression en cascade : l'historique des commandes doit être conservé.
model Order {
  id                 String       @id @default(uuid())
  buyerId            String
  buyer              User         @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  producerId         String
  producer           Producer     @relation(fields: [producerId], references: [id], onDelete: Restrict)
  // Renseigné quand la commande vient d'une offre acceptée
  offerId            String?      @unique
  offer              Offer?       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  status             OrderStatus
  // Somme des lignes, en GNF. BigInt : prix × quantité peut dépasser la capacité d'un Int.
  totalAmount        BigInt
  deliveryRegion     String
  deliveryPrefecture String
  deliveryCommune    String?
  deliveryAddress    String
  // Date de livraison prévue, facultative
  deliveryDate       DateTime?    @db.Date
  // Message de l'acheteur au producteur
  note               String?
  // Vrai quand la quantité commandée a été retirée du stock du produit (commande du catalogue
  // acceptée) : elle y est remise si la commande est annulée.
  stockReserved      Boolean      @default(false)
  items              OrderItem[]
  events             OrderEvent[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([buyerId, createdAt])
  @@index([producerId, createdAt])
}

// Ligne d'une commande. Nom, unité et prix sont copiés au moment de la commande :
// une modification ultérieure du produit ne change pas la commande.
model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unit        ProductUnit
  // Prix en GNF par unité
  unitPrice   Int
  quantity    Int
  lineTotal   BigInt

  @@index([orderId])
}

// Historique d'une commande : un enregistrement par changement de statut (§10).
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  // Utilisateur à l'origine du changement
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Motif d'une annulation ou d'un refus, précision facultative sinon
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}
