# Configuration des tests e2e : copier en `.env.test` puis compléter.
# Ne jamais commiter `.env.test`.

# Base DÉDIÉE aux tests : elle est vidée avant chaque test.
# Son nom doit se terminer par « _test », sinon les tests refusent de s'exécuter.
# Création (une seule fois) : docker exec farmmarket-postgres createdb -U farmmarket_user farmmarket_test
DATABASE_URL="postgresql://farmmarket_user:<mot_de_passe>@localhost:5433/farmmarket_test?schema=public"

# Secret propre aux tests (différent de celui de .env)
JWT_SECRET=
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000
