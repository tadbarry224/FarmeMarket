# Copier ce fichier en `.env` puis renseigner les valeurs.
# Ne jamais commiter le fichier `.env`.

# Connexion PostgreSQL (conteneur défini dans ../compose.yaml, port 5433)
DATABASE_URL="postgresql://farmmarket_user:<mot_de_passe>@localhost:5433/farmmarket?schema=public"

# Authentification JWT
# Générer un secret : node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Adresse du frontend, utilisée dans les liens envoyés par e-mail
FRONTEND_URL=http://localhost:3000

# E-mails
# Sans SMTP_HOST : les e-mails sont affichés dans la console (développement uniquement).
# En production (NODE_ENV=production), SMTP_HOST est obligatoire.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="FarmMarket <noreply@votre-domaine>"
